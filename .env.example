# Copia questo file in ".env" per lo sviluppo locale.
# Su Render, imposta le stesse chiavi in Dashboard → Environment (il file .env non viene letto lì).

# Chiave API di Google Gemini (obbligatoria per generare esercitazioni e lezioni di recupero)
GEMINI_API_KEY=

# Modello Gemini da usare (opzionale, default: gemini-flash-latest)
GEMINI_MODEL=

# Email con accesso all'Area Gestione, separate da virgola (es. "io@esempio.it,paola@esempio.it").
# Il ruolo viene assegnato/aggiornato automaticamente al login: nessun account
# è admin finché la sua email non compare qui.
ADMIN_EMAILS=

# Database persistente su Turso (opzionale: senza queste due variabili, i dati
# vengono salvati su file locale e NON sopravvivono ai redeploy su Render
# senza Persistent Disk)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Invio email (opzionale, via Resend: resend.com). Senza questa chiave l'app
# funziona normalmente ma non manda email di benvenuto, conferma indirizzo,
# reset PIN o notifiche di nuove segnalazioni.
RESEND_API_KEY=

# Mittente delle email (deve essere un dominio verificato su Resend, oppure
# lascia "onboarding@resend.dev" per fare dei test)
EMAIL_MITTENTE=onboarding@resend.dev

# URL pubblico del sito, usato per costruire i link nelle email (conferma
# email, reset PIN). Su Render di solito NON serve impostarla: viene usata
# automaticamente RENDER_EXTERNAL_URL, fornita da Render stesso. Imposta
# APP_URL solo per sviluppo locale o per un dominio personalizzato.
APP_URL=
